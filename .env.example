# Adres bazy PostgreSQL (wymagane — bez tego aplikacja nie wystartuje)
DATABASE_URL=postgresql://featureboard:localdevpassword@localhost:5432/featureboard

# Nazwa środowiska pokazywana na / (opcjonalne, default: local)
ENVIRONMENT=local

# Wersja aplikacji pokazywana na / (opcjonalne, default: 0.0.0-dev)
APP_VERSION=0.1.0